# Network for gltest / genlayer CLI: studionet | localnet | bradbury | asimov
GENLAYER_NETWORK=studionet

# Set to 0 to run tests/integration against a live network.
SKIP_INTEGRATION=1

# Keys for scripts/drive_e2e.mjs. NEVER commit funded keys.
# StudioNet is gasless, but the client still needs GEN for escrow.
AGENTSLA_CLIENT_KEY=
AGENTSLA_PROVIDER_KEY=
