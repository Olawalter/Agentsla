# Network for gltest / genlayer CLI: studionet | localnet | bradbury | asimov
GENLAYER_NETWORK=studionet

# Set to 0 to run tests/integration against a live network.
SKIP_INTEGRATION=1

# The live suite needs no keys: it creates throwaway accounts and funds
# them from the StudioNet faucet. Optionally reuse a deployment:
AGENTSLA_CONTRACT=
